# RATCHET — copy to `.env` and fill in. NEVER commit `.env`.
#
#   cp .env.example .env
#
# Everything below is OPTIONAL. With an empty .env the whole loop runs in
# fixture mode with zero network — that is the demo-safe default. Each key you
# add upgrades exactly one adapter to live; if a key is missing or the service
# is unreachable, that adapter degrades back to its fixture and sets
# `degraded: true` in the run metrics. Nothing ever crashes the loop.

# ---------------------------------------------------------------- mode switches
# fixture (default) = no network at all. live = try the sponsor APIs.
RATCHET_MODE=fixture
# Per-adapter override — beats RATCHET_MODE. Useful to demo one live
# integration at a time without risking the rest of the run.
#   RATCHET_ROUTER_MODE=live
#   RATCHET_MEMORY_MODE=live
#   RATCHET_QA_MODE=live
#   RATCHET_TRACER_MODE=live
#   RATCHET_PUBLISHER_MODE=live
# Seconds before any sponsor HTTP call gives up and degrades.
RATCHET_HTTP_TIMEOUT=20

# ------------------------------------------------- Pioneer (Fastino Labs) — Router
# Inference API + adaptive model router. OpenAI-compatible.
# Sign up: agent.pioneer.ai -> Billing -> "Get Pro" -> apply the event promo code.
PIONEER_API_KEY=
PIONEER_BASE_URL=https://api.pioneer.ai/v1
# Warm path (cheap, reuses a retrieved fix-pattern) and cold path (frontier
# reasoning on an unseen root cause). These must be genuinely different models.
PIONEER_CHEAP_MODEL=gemma
PIONEER_STRONG_MODEL=claude-sonnet-5
# Let Pioneer's router substitute a cheaper equivalent model as it learns our
# traffic — this is the "improve inference" leg of the stack. Set false to pin.
PIONEER_ADAPTIVE=true
PIONEER_MAX_TOKENS=1200

# ------------------------------------------- Actian VectorAI DB — Memory (thesis)
# Portable, off-cloud vector DB = persistent agent memory.
# Server:  docker run -p 6574:6574 vectoraidb
# SDK:     pip install actian-vectorai   (Community Edition; not on public PyPI
#          as of today — grab it from actian.com/databases/vectorai-db)
# No API key: it is a local server.
ACTIAN_ENDPOINT=localhost:6574
ACTIAN_COLLECTION=ratchet_fix_patterns

# ------------------------------------------------------------- Replay QA — QA
# Feed it a URL, get back root-caused bug reports (spec: qa.replay.io/api/v1/openapi.json).
# Token from Replay QA Settings > API — it starts with "lqa_".
REPLAY_API_KEY=
REPLAY_BASE_URL=https://qa.replay.io
# The deployed fixture app Replay should explore (public URL from Lane C).
RATCHET_TARGET_URL=
# Exploration is async; polling budget before we degrade to fixture (~3 min).
REPLAY_POLL_SECONDS=10
REPLAY_POLL_MAX=18
# Fallback if the public URL breaks: Replay can reach localhost through their
# own tunnel. Set true and follow reverse_proxy_setup_url in .ratchet/replay_project.json.
REPLAY_USE_REVERSE_PROXY=false

# ---------------------------------------------------------- Guild.ai — Tracer
# Control plane: govern, run and trace agents. Open beta, 50M free tokens.
# Sign up at guild.ai (GitHub/Google/email).
GUILD_API_KEY=
GUILD_BASE_URL=https://api.guild.ai/v1
GUILD_PROJECT=ratchet

# -------------------------------------------------- Senso Context OS — Publisher
# Programmable knowledge base with endpoints that publish content to the web so
# other agents can discover it. $100 credit on signup. docs.senso.ai
SENSO_API_KEY=
SENSO_BASE_URL=https://apiv2.senso.ai/api/v1
# Where published patterns land locally regardless of backend.
RATCHET_CITED_PATH=cited.md

# ------------------------------------------------------- Google DeepMind (Gemini)
# Only needed if the cold path calls Gemini directly instead of via Pioneer.
GEMINI_API_KEY=
